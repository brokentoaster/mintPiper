#!/bin/bash
# speak-watch — speak stdout updates only after output goes quiet.
# Like `watch`, but for voice: debounces a stream and speaks the last line
# (default) or all lines since the previous announcement (delta mode).
#
# Usage: some-command | speak-watch [voice] [quiet_secs] [-d|--delta] [-l|--last] [--stream]
#   voice       numeric index (1-based) or short name, e.g. alan, alba
#   quiet_secs  seconds of silence before speaking (default 1; invalid -> 1)
#   -d, --delta speak all lines since the last announcement
#   -l, --last  speak only the last line (default)
#   --stream    pass --stream through to the speak script
# Env:
#   SPEAK_WATCH_MAX_CHARS  truncate spoken text to N chars (default 300)
#   SPEAK_WATCH_STUB       command to receive text instead of TTS (for testing)
set -uo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
. "$here/piper-lib.sh"

MAX_CHARS="${SPEAK_WATCH_MAX_CHARS:-300}"
mode="last"
stream=0
positional=()

for arg in "$@"; do
	case "$arg" in
		-d|--delta) mode="delta" ;;
		-l|--last) mode="last" ;;
		--stream) stream=1 ;;
		-h|--help)
			grep "^#" "$0" | grep -v "^#!/bin/bash" | sed 's/^# \{0,1\}//'
			exit 0
			;;
		-*)
			echo "Unknown option: $arg" >&2
			exit 1
			;;
		*)
			positional+=("$arg")
			;;
	esac
done
voice="${positional[0]:-}"
quiet="${positional[1]:-1}"
[[ "$quiet" =~ ^[0-9]+([.][0-9]+)?$ ]] || quiet="1"
# read -t 0 polls without blocking and would spin; clamp to a small minimum
awk -v q="$quiet" 'BEGIN{exit !(q+0 < 0.05)}' && quiet="0.05"

watch_speak() {
	local text="$1"
	if [ -n "${SPEAK_WATCH_STUB:-}" ]; then
		printf '%s\n' "$text" | $SPEAK_WATCH_STUB
		return
	fi
	speak_text "$voice" "" "$stream" "$text"
}

# fail fast on an invalid voice before watching (unless stubbed for tests)
if [ -z "${SPEAK_WATCH_STUB:-}" ] && [ -n "$voice" ]; then
	find_voice "$voice" >/dev/null
fi

flush_burst() {
	local burst="$1" text
	if [ "$mode" = "delta" ]; then
		text=$(printf '%b' "$burst" | tr '\n' ' ')
	else
		text=$(printf '%b' "$burst" | tail -n 1)
	fi
	text=$(printf '%s' "$text" \
		| sed -E 's/[|`#*_~]+//g; s/https?:\/\/[^ ]+/link/g; s/([0-9]+)%/\1 percent/g; s/[[:space:]]+$//')
	[ ${#text} -gt "$MAX_CHARS" ] && text="${text:0:$MAX_CHARS}"
	[ -n "$text" ] && watch_speak "$text"
}

# Debounce: speak the pending burst once `quiet` seconds pass with no new
# input. Each arriving line restarts the quiet window. EOF flushes and exits.
line=""
burst=""
deadline="$quiet"
while :; do
	if IFS= read -r -t "$deadline" line; then
		[ -n "$line" ] && burst="${burst:+$burst\n}$line"
		deadline="$quiet"
	else
		ret=$?
		# final line without trailing newline: read fails but keeps text
		[ -n "$line" ] && burst="${burst:+$burst\n}$line"
		line=""
		if [ $ret -gt 128 ]; then
			# quiet window elapsed -> speak burst, keep watching
			if [ -n "$burst" ]; then
				flush_burst "$burst"
				burst=""
			fi
		else
			# EOF: flush what remains and stop
			[ -n "$burst" ] && flush_burst "$burst"
			exit 0
		fi
	fi
done
