#!/bin/bash
# speak — speak text aloud with piper.
# Usage: speak [voice] [file] [speaker] [--stream]
#   voice    numeric index (1-based) or short name, e.g. alan, alba
#   file     path to a text file; if omitted, text is read from stdin
#   speaker  numeric speaker id (0-based); must be < num_speakers of the voice
#   --stream pipe piper's raw audio straight to aplay (no wav file, starts sooner)
set -eo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
. "$here/piper-lib.sh"

stream=0
positional=()
for a in "$@"; do
	case "$a" in
		--stream) stream=1 ;;
		-h|--help)
			grep "^#" "$0" | grep -v "^#!/bin/bash" | sed 's/^# \{0,1\}//'
			exit 0
			;;
		*) positional+=("$a") ;;
	esac
done
voice_arg="${positional[0]:-}"
file_arg="${positional[1]:-}"
speaker_arg="${positional[2]:-}"

require_piper
voice_file="$(find_voice "$voice_arg")"
speaker="$(find_speaker "$voice_file" "$speaker_arg")"
sample_rate="$(find_sample_rate "$voice_file")"

read_text() {
	if [ -n "$file_arg" ]; then
		cat "$file_arg"
	else
		cat
	fi
}

if [ "$stream" = 1 ]; then
	read_text | sed -u 's/^$/./' \
		| "$PIPER_DIR/piper" --model "$PIPER_DIR/$voice_file" --speaker "$speaker" \
			--sentence-silence 1 --output-raw \
		| aplay -f S16_LE -r "$sample_rate" -c 1
	exit 0
fi

tmp=$(mktemp /tmp/speak.XXXXXX.wav)
trap 'rm -f "$tmp"' EXIT

read_text | sed -u 's/^$/./' \
	| "$PIPER_DIR/piper" --model "$PIPER_DIR/$voice_file" --speaker "$speaker" \
		--sentence-silence 1 --output_file "$tmp"

aplay "$PIPER_DIR/silence.wav" "$tmp" 2>/dev/null
